# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/fullmoon?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=password

# Azure Blob Storage Configuration
# The endpoint of your Azure Storage Account
spring.cloud.azure.storage.blob.endpoint=https://<your-storage-account-name>.blob.core.windows.net
# The container name to store images (must exist)
spring.cloud.azure.storage.blob.container-name=fullmoon-images
# Authentication: Choose ONE method below
# Method 1: Connection String (Easiest for dev)
spring.cloud.azure.storage.blob.connection-string=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Method 2: Account Name & Key
# spring.cloud.azure.storage.blob.account-name=<your-storage-account-name>
# spring.cloud.azure.storage.blob.account-key=<your-storage-account-key>

# External AI Service
# URL where the FastAPI service is running
fastapi.base-url=http://localhost:8000

# Security (JWT)
# Must be at least 32 bytes (256 bits) for HS256
jwt.secret=your_super_secret_key_change_this_to_something_secure_and_long
